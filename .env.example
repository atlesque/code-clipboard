# Copy to .env and fill in. Never commit .env.
# Full URL of the ntfy topic to watch (server + topic name).
NTFY_TOPIC_URL=https://ntfy.example.com/email-codes
# Reverse-DNS id for your build; also used as the Keychain service name.
BUNDLE_ID=com.example.code-clipboard
# Optional: access token for a read-only ntfy user (or pass NTFY_TOKEN=… ./build.sh once).
# NTFY_TOKEN=tk_...
